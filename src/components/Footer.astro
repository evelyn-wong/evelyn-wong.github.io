---
import logoEvelyn from '../assets/logo-evelyn.svg'
import { author } from '../sample'
import { useTranslations } from '../i18n/ui'

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props as Props;
const t = useTranslations(lang);

const socials = [
  { icon: 'ri-mail-line', link: author.email, label: 'Email' },
]

---

<footer class="border-t-4 px-5 md:px-0 py-10 mt-30">
    <div class="max-w-3xl mx-auto flex justify-center flex-col gap-5 md:gap-0 md:grid md:grid-cols-3 items-center">
      <div class="flex-1 font-bold">
        <a href={lang === "en" ? "/en/" : "/"} class="flex items-center gap-3 text-xl">
            <img src={logoEvelyn.src} alt="logo" width="30" /> {author.nickname}
        </a>
      </div>
      <div class="text-center">
        <p>© {new Date().getFullYear()} {author.nickname}. {t("footer.rights")}</p>
      </div>
      <div class="flex md:justify-end gap-5">
        {socials.map(item => ( 
          <a href={item.link} target="_blank" class="transition-all duration-200 hover:translate-y-[2px]"><i class={`${item.icon} text-2xl`}></i></a>
        ))}
      </div>
    </div>
   </footer>
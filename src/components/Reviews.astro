---
import svgNew from '../assets/new.svg'
import { useTranslations } from '../i18n/ui'

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props as Props;
const t = useTranslations(lang as "es" | "en");

const testimonials = [
  {
    commentKey: `reviews.jonathan.comment`,
    author: {
      nameKey: `reviews.jonathan.name`,
      roleKey: `reviews.jonathan.role`,
      pic: `https://media.licdn.com/dms/image/v2/C4D03AQGZp0pAwJrXEA/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1516297288265?e=1735689600&v=beta&t=BgZWYp4h5Z9X2Vn8h8hFzfaS5hJ0ZI6vKJqLbN5KyeY`
    },
    cls: `rotate-2 -translate-y-10`
   },
]
---


<section>
    <div class="max-w-4xl mx-auto pb-20 px-10 overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="flex relative">
          <h1 class="text-3xl">{t("reviews.title")}</h1>
          <img src={svgNew.src} alt="arrow" width="40" class="absolute -right-3 md:-right-10 bottom-0" />
        </div>
      </div>


      <div class="grid grid-cols-1 py-30">
        {testimonials.map(item => (
          <div class={`flex flex-col gap-3 p-5 pr-15 bg-white border-2 shadow-[6px_6px_0px_rgba(0,0,0,0.3)] ${item.cls}`}>
            <p>"{ t(item.commentKey as any) }"</p>
            <div class="flex items-center gap-2">
              <div><div class="size-11 rounded-full border overflow-hidden">
                  <img src={item.author.pic} alt="" class="w-full h-full object-cover" />
              </div></div>
              <div>
                <h3 class="font-medium">{t(item.author.nameKey as any)}</h3>
                <p>{t(item.author.roleKey as any)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
   </section>

---
interface Props {
  lang?: "es" | "en";
  title?: string;
}

const { lang = "es", title = "Evelyn Wong - Arquitecta | Portafolio Profesional" } = Astro.props as Props;
const pageTitle = lang === "en" ? "Evelyn Wong - Architect | Professional Portfolio" : title;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>

:root{
	--main-bg: #FEFFF0;
	--blue: #BAE6FF;
	--yellow: #FFDC58;
}

html,
body {
	margin: 0;
	width: 100%;
	height: 100%;
	background-color: var(--main-bg);
	font-family: "Space Grotesk", sans-serif;
	scroll-behavior: smooth;
}


</style>
